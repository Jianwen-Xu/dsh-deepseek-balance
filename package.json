{
    "name": "dsh-deepseek-balance",
    "version": "1.0.0",
    "description": "DSH 插件：在 Web 侧边栏显示 DeepSeek API 余额与高峰/空闲计费时段",
    "license": "MIT",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": "./lib/index.js",
        "./client": "./lib/client.js",
        "./package.json": "./package.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Jianwen-Xu/dsh-deepseek-balance.git"
    },
    "homepage": "https://github.com/Jianwen-Xu/dsh-deepseek-balance#readme",
    "bugs": {
        "url": "https://github.com/Jianwen-Xu/dsh-deepseek-balance/issues"
    },
    "keywords": [
        "dsh",
        "dsh-plugin",
        "dsh-bundle",
        "deepseek",
        "deepseek-harness",
        "balance"
    ],
    "engines": {
        "node": ">=22"
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsdown",
        "prepare": "tsdown"
    },
    "files": [
        "lib",
        "cordis.patch.yml",
        "README.md"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [
                "@deepseek-ai/dsh-client-ui-slots"
            ]
        }
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "tsdown": "^0.23.0"
    }
}
